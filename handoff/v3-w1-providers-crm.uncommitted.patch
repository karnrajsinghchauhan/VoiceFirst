+"""HubSpot CRM adapter: CRM v3 tickets batch upsert keyed by a unique property (S5).
+
+Every call is one ticket keyed by the mapping's external id property (av_call_id, a
+unique-value custom property). Notes are engagements associated to the ticket. Auth is a
+private-app access token from the platform secret store.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+import httpx
+from pydantic import BaseModel, ConfigDict, ValidationError
+from pydantic_settings import BaseSettings, SettingsConfigDict
+
+from app.core.errors import ConfigError, ProviderError, ProviderTimeoutError
+from app.crm.mapping import CrmMapping, mapped_properties
+from app.providers.base import CrmCallRecord, CrmTicket
+
+API = "https://api.hubapi.com"
+_PRIORITY = {"low": "LOW", "normal": "MEDIUM", "high": "HIGH", "urgent": "HIGH"}
+# HubSpot's built-in note-to-ticket association type.
+NOTE_TO_TICKET_ASSOCIATION = 228
+
+
+class HubSpotSettings(BaseSettings):
+    model_config = SettingsConfigDict(env_prefix="AV_HUBSPOT_", extra="ignore", frozen=True)
+
+    access_token: str = ""
+    pipeline: str = "0"
+    pipeline_stage: str = "1"
+    portal_id: str = ""
+    timeout_seconds: float = 10.0
+
+    def require_complete(self) -> None:
+        missing = [k for k in ("access_token", "portal_id") if not getattr(self, k)]
+        if missing:
+            raise ConfigError(
