+++ b/server/app/crm/retry_dlq.py
@@ -0,0 +1,57 @@
+"""Replays dead-lettered CRM records: `python -m app.crm.retry_dlq`. Safe to run repeatedly
+because every CRM write is an upsert by call_id."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from sqlalchemy.orm import Session
+
+from app.core.clock import Clock
+from app.core.errors import ProviderError
+from app.crm.sync import record_from_payload
+from app.delivery.dlq import open_items, resolve
+from app.providers.base import CrmProvider
+
+
+@dataclass(frozen=True)
+class RetryReport:
+    retried: int
+    resolved: int
+    still_failing: int
+
+
+def retry_crm(session: Session, crm: CrmProvider, clock: Clock) -> RetryReport:
+    resolved = failing = 0
+    items = [row for row in open_items(session, "crm") if row.target == crm.name]
+    for row in items:
+        try:
+            crm.upsert_call_record(record_from_payload(row.payload))
+        except ProviderError as exc:
+            row.attempts += 1
+            row.error = f"{exc.code}: {exc}"
+            row.last_attempt_at = clock.now()
+            failing += 1
+            continue
+        resolve(session, row, clock.now())
+        resolved += 1
+    session.flush()
+    return RetryReport(retried=len(items), resolved=resolved, still_failing=failing)
+
+
+def main() -> None:
+    from app.core.clock import SystemClock
+    from app.core.config import get_settings
+    from app.core.db import make_engine, make_session_factory, transaction
+    from app.core.logging import configure_logging, get_logger
+    from app.crm.factory import make_crm
+
+    configure_logging()
+    settings = get_settings()
+    with transaction(make_session_factory(make_engine(settings.database_url))) as session:
+        report = retry_crm(session, make_crm(settings), SystemClock())
+    get_logger(__name__).info("crm dlq retry", extra=report.__dict__)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/server/app/crm/sync.py b/server/app/crm/sync.py
new file mode 100644
index 0000000..5fd2429
--- /dev/null
+++ b/server/app/crm/sync.py
@@ -0,0 +1,136 @@
+"""Post-call CRM sync (S5): every handled call becomes one CRM record, keyed by call_id.
+
+A CRM failure never loses the record: it lands in the dead-letter queue and pages a human,
+and `python -m app.crm.retry_dlq` replays it. Retrying is safe because the write is an
+upsert by call_id.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict
+from typing import Literal, Protocol
+
+from pydantic import TypeAdapter
+from sqlalchemy.orm import Session
+
+from app.contracts.generated.call_outcome import CallOutcome
+from app.contracts.generated.handoff_summary import HandoffSummary
+from app.core.clock import Clock
+from app.core.config import Settings
+from app.core.errors import ProviderError
+from app.crm.cases import priority_for
+from app.delivery.dlq import dead_letter
+from app.handoff.summary import render_lines
+from app.providers.base import CrmCallRecord, CrmProvider
+
+SyncResult = Literal["written", "dead_lettered"]
+# Outcomes where a person was on the line and the call was handled end to end.
+HANDLED: frozenset[str] = frozenset(
+    {
+        "link_sent",
+        "details_confirmed",
+        "callback_scheduled",
+        "handed_off",
+        "opted_out",
+        "wrong_person",
+        "minor_on_line",
+        "declined",
+        "abandoned",
+        "error",
+    }
+)
+_NEXT_ACTION = {
+    "link_sent": ("Watch for payment before the due date", "ai"),
+    "details_confirmed": ("None; stay details confirmed", "ai"),
+    "callback_scheduled": ("Call the customer back at the booked time", "cx_team"),
+    "handed_off": ("Human agent owns the case", "cx_team"),
+    "opted_out": ("None; number opted out", "compliance"),
+    "wrong_person": ("Verify the contact number on the booking", "cx_team"),
+    "minor_on_line": ("Call back for the booker; nothing was discussed", "cx_team"),
+    "declined": ("None; customer declined, do not repeat the ask", "ai"),
+    "abandoned": ("Review the transcript", "cx_team"),
+    "error": ("Review the error and call back if needed", "cx_team"),
+}
+
+
+class QaScoreSource(Protocol):
+    """Supplied by the QA scorecard (W-2). None until a scorecard exists for the call."""
+
+    def score_for(self, call_id: str) -> float | None: ...
+
+
+class NoQaScores:
+    def score_for(self, call_id: str) -> float | None:
+        return None
+
+
+def transcript_url(console_base_url: str, call_id: str) -> str:
+    # The console enforces the auditor role and serves only the redacted transcript.
+    return f"{console_base_url.rstrip('/')}/console/calls/{call_id}"
+
+
+def build_record(
+    outcome: CallOutcome,
+    summary: HandoffSummary | None,
+    booking_masked: str,
+    qa_score: float | None,
+    console_base_url: str,
+) -> CrmCallRecord:
+    next_action, owner = _NEXT_ACTION[outcome.outcome]
+    cost = outcome.cost
+    total = cost.telephony + cost.stt + cost.tts + cost.llm + cost.whatsapp
+    lines = render_lines(summary) if summary else [f"Outcome: {outcome.outcome}"]
+    url = transcript_url(console_base_url, outcome.call_id)
+    qa = "pending" if qa_score is None else f"{qa_score:.2f}"
+    body = "\n".join(
+        [
+            *lines,
+            f"QA score: {qa}",
+            f"Cost: {total} paise",
+            f"Transcript (redacted, access-controlled): {url}",
+            f"Grievance channel: {outcome.grievance_channel}",
+        ]
+    )
+    return CrmCallRecord(
+        call_id=outcome.call_id,
+        subject=f"Agoda Voice {outcome.purpose}: {outcome.outcome} ({booking_masked})",
+        body=body,
+        outcome=outcome.outcome,
+        booking_masked=booking_masked,
+        qa_score=qa_score,
+        transcript_url=url,
+        cost_paise=total,
+        next_action=next_action,
+        owner=owner,
+        priority=priority_for(summary) if summary else "normal",
+        tags=("agoda_voice", f"outcome_{outcome.outcome}", f"journey_{outcome.purpose}"),
+    )
+
+
+def deliver(
+    session: Session, crm: CrmProvider, settings: Settings, clock: Clock, record: CrmCallRecord
+) -> SyncResult:
+    try:
+        crm.upsert_call_record(record)
+    except ProviderError as exc:
+        payload = {k: (list(v) if isinstance(v, tuple) else v) for k, v in asdict(record).items()}
+        dead_letter(
+            session,
+            tenant_id=settings.tenant_id,
+            kind="crm",
+            key=record.call_id,
+            target=crm.name,
+            payload=payload,
+            error=f"{exc.code}: {exc}",
+            now=clock.now(),
+        )
+        return "dead_lettered"
+    return "written"
+
+
+_RECORD = TypeAdapter(CrmCallRecord)
+
+
+def record_from_payload(payload: dict[str, object]) -> CrmCallRecord:
+    """The DLQ payload is JSON from our own table, still validated: it is a storage edge."""
+    return _RECORD.validate_python(payload)
