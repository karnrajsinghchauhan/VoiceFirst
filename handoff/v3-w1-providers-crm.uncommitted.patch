@@ -0,0 +1,104 @@
+"""Outbound webhooks: HMAC over timestamp.body, receiver rejects tamper, stale and replay."""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from app.core.errors import AgodaVoiceError, WebhookReplayError, WebhookSignatureError
+from app.delivery.dlq import open_items
+from app.postcall.crypto import DataCipher
+from app.postcall.settings import PostcallSettings
+from app.simulator.caller import load_personas
+from app.simulator.scenario import run_text
+from app.webhooks_out.deliver import publish_call_outcome, subscribe
+from app.webhooks_out.signing import signed_headers, verify
+
+CIPHER = DataCipher(PostcallSettings().data_key)
+
+
+def _outcome(settings):
+    persona = next(p for p in load_personas() if p.id == "C-01")
+    return run_text(settings, persona, "hinglish", 0).result.outcome
+
+
+def test_receiver_accepts_a_fresh_signed_event_once():
+    body = b'{"event":"call_outcome"}'
+    headers = signed_headers("s3cret", 1_800_000_000, "evt_1", body)
+    seen: set[str] = set()
+
+    def seen_before(event_id: str) -> bool:
+        if event_id in seen:
+            return True
+        seen.add(event_id)
+        return False
+
+    assert verify("s3cret", headers, body, 1_800_000_010, seen_before) == "evt_1"
+    with pytest.raises(WebhookReplayError):
+        verify("s3cret", headers, body, 1_800_000_020, seen_before)
+
+
+def test_receiver_rejects_tamper_wrong_secret_and_stale():
+    body = b'{"event":"call_outcome"}'
+    headers = signed_headers("s3cret", 1_800_000_000, "evt_1", body)
+    with pytest.raises(WebhookSignatureError):
+        verify("s3cret", headers, body + b" ", 1_800_000_000, lambda _: False)
+    with pytest.raises(WebhookSignatureError):
+        verify("other", headers, body, 1_800_000_000, lambda _: False)
+    with pytest.raises(WebhookReplayError):
+        verify("s3cret", headers, body, 1_800_000_301, lambda _: False)
+    with pytest.raises(WebhookSignatureError):
+        verify("s3cret", {}, body, 1_800_000_000, lambda _: False)
+
+
+def test_publish_signs_with_the_subscription_secret(session, settings, clock):
+    sub = subscribe(
+        session,
+        CIPHER,
+        clock,
+        tenant_id=settings.tenant_id,
+        url="https://hooks.example.invalid/av",
+        events=["call_outcome"],
+    )
+    received: list[httpx.Request] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        received.append(request)
+        return httpx.Response(204)
+
+    client = httpx.Client(transport=httpx.MockTransport(handler))
+    outcome = _outcome(settings)
+    assert publish_call_outcome(session, CIPHER, clock, client, outcome) == {
+        sub.subscription_id: "delivered"
+    }
+    req = received[0]
+    verify(
+        sub.secret, dict(req.headers), req.content, int(clock.now().timestamp()), lambda _: False
+    )
+
+
+def test_failed_delivery_dead_letters(session, settings, clock):
+    subscribe(
+        session,
+        CIPHER,
+        clock,
+        tenant_id=settings.tenant_id,
+        url="https://hooks.example.invalid/av",
+        events=["call_outcome"],
+    )
+    client = httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(503)))
+    result = publish_call_outcome(session, CIPHER, clock, client, _outcome(settings))
+    assert list(result.values()) == ["dead_lettered"]
+    assert len(open_items(session, "webhook")) == 1
+
