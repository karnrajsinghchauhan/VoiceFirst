@@ -0,0 +1,111 @@
+"""Delivers call_outcome events to every active subscriber. Failures dead-letter and page."""
+
+from __future__ import annotations
+
+import json
+import secrets
+from dataclasses import dataclass
+from typing import Any, Literal
+
+import httpx
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.contracts.generated.call_outcome import CallOutcome
+from app.core.clock import Clock
+from app.core.errors import AgodaVoiceError
+from app.core.ids import new_id
+from app.delivery.dlq import dead_letter
+from app.postcall.crypto import DataCipher
+from app.webhooks_out.models import WebhookSubscriptionRow
+from app.webhooks_out.signing import signed_headers
+
+EventName = Literal["call_outcome"]
+DeliveryResult = Literal["delivered", "dead_lettered"]
+TIMEOUT_SECONDS = 5.0
+
+
+@dataclass(frozen=True)
+class NewSubscription:
+    subscription_id: str
+    secret: str  # shown once to the subscriber, then only the ciphertext is kept
+
+
+def subscribe(
+    session: Session,
+    cipher: DataCipher,
+    clock: Clock,
+    *,
+    tenant_id: str,
+    url: str,
+    events: list[EventName],
+) -> NewSubscription:
+    if not url.startswith("https://"):
+        raise AgodaVoiceError("webhook URLs must be https")
+    secret = secrets.token_hex(32)
+    row = WebhookSubscriptionRow(
+        subscription_id=new_id("whs"),
+        tenant_id=tenant_id,
+        url=url,
+        events=list(events),
+        secret_ciphertext=cipher.encrypt_json(secret),
+        active=True,
+        created_at=clock.now(),
+    )
+    session.add(row)
+    session.flush()
+    return NewSubscription(subscription_id=row.subscription_id, secret=secret)
+
+
+def _body(outcome: CallOutcome, event_id: str) -> bytes:
+    payload: dict[str, Any] = {
+        "event": "call_outcome",
+        "event_id": event_id,
+        "data": json.loads(outcome.model_dump_json()),
+    }
+    return json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
+
+
+def publish_call_outcome(
+    session: Session,
+    cipher: DataCipher,
+    clock: Clock,
+    client: httpx.Client,
+    outcome: CallOutcome,
+) -> dict[str, DeliveryResult]:
+    """One signed POST per subscriber. Returns the result per subscription id."""
+    subs = session.scalars(
+        select(WebhookSubscriptionRow).where(
+            WebhookSubscriptionRow.tenant_id == outcome.tenant_id,
+            WebhookSubscriptionRow.active.is_(True),
+        )
+    )
+    results: dict[str, DeliveryResult] = {}
+    for sub in subs:
+        if "call_outcome" not in sub.events:
+            continue
+        # Stable per (call, subscription) so a retried delivery is recognisably the same event.
+        event_id = f"evt_{outcome.call_id}_{sub.subscription_id}"
+        body = _body(outcome, event_id)
+        secret = str(cipher.decrypt_json(sub.secret_ciphertext))
+        headers = signed_headers(secret, int(clock.now().timestamp()), event_id, body)
+        try:
+            response = client.post(sub.url, content=body, headers=headers, timeout=TIMEOUT_SECONDS)
+            failure = None if 200 <= response.status_code < 300 else f"HTTP {response.status_code}"
+        except httpx.HTTPError as exc:
+            failure = f"{type(exc).__name__}: {exc}"
+        if failure is None:
+            results[sub.subscription_id] = "delivered"
+            continue
+        dead_letter(
+            session,
+            tenant_id=outcome.tenant_id,
+            kind="webhook",
+            key=event_id,
+            target=sub.subscription_id,
+            payload={"url": sub.url, "body": body.decode()},
+            error=failure,
+            now=clock.now(),
+        )
+        results[sub.subscription_id] = "dead_lettered"
+    return results
