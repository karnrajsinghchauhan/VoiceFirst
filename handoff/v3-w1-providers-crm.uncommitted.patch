index 0000000..c2e2f21
--- /dev/null
+++ b/server/app/delivery/dlq.py
@@ -0,0 +1,77 @@
+"""Writing to and reading from the dead-letter queue."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.core.ids import new_id
+from app.delivery.models import DeadLetterRow, DeliveryKind
+from app.incidents.service import page_human
+
+
+def dead_letter(
+    session: Session,
+    *,
+    tenant_id: str,
+    kind: DeliveryKind,
+    key: str,
+    target: str,
+    payload: dict[str, Any],
+    error: str,
+    now: datetime,
+) -> DeadLetterRow:
+    """Records the failed delivery and pages a human. One open row per (kind, key, target)."""
+    row = session.scalar(
+        select(DeadLetterRow).where(
+            DeadLetterRow.kind == kind,
+            DeadLetterRow.key == key,
+            DeadLetterRow.target == target,
+            DeadLetterRow.resolved_at.is_(None),
+        )
+    )
+    if row is None:
+        row = DeadLetterRow(
+            dlq_id=new_id("dlq"),
+            kind=kind,
+            key=key,
+            target=target,
+            payload=payload,
+            error=error,
+            attempts=1,
+            created_at=now,
+            last_attempt_at=now,
+            resolved_at=None,
+        )
+        session.add(row)
+        page_human(
+            session,
+            tenant_id=tenant_id,
+            at=now,
+            severity="sev2",
+            summary=f"{kind} delivery to {target} failed for {key}: {error}",
+        )
+    else:
+        row.attempts += 1
+        row.error = error
+        row.last_attempt_at = now
+        row.payload = payload
+    session.flush()
+    return row
+
+
+def open_items(session: Session, kind: DeliveryKind) -> list[DeadLetterRow]:
+    stmt = (
+        select(DeadLetterRow)
+        .where(DeadLetterRow.kind == kind, DeadLetterRow.resolved_at.is_(None))
+        .order_by(DeadLetterRow.created_at)
+    )
+    return list(session.scalars(stmt))
+
+
+def resolve(session: Session, row: DeadLetterRow, now: datetime) -> None:
+    row.resolved_at = now
+    session.flush()
