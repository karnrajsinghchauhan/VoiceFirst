index 0000000..b4c7674
--- /dev/null
+++ b/server/app/crm/mapping.py
@@ -0,0 +1,84 @@
+"""CRM field mapping, loaded from app/crm/mappings/<crm>.yaml and validated at boot.
+
+The mapping says where each mappable field of a CrmCallRecord lands in the client's CRM
+(a Zendesk custom field id, a Salesforce field API name, a HubSpot property). Field ids
+are the client's [CD]; the YAML is the only place they live.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import yaml
+
+from app.core.errors import MappingConfigError
+from app.providers.base import CrmCallRecord
+
+MAPPABLE: frozenset[str] = frozenset(
+    {
+        "outcome",
+        "booking_masked",
+        "qa_score",
+        "transcript_url",
+        "cost_paise",
+        "next_action",
+        "owner",
+    }
+)
+MAPPINGS_DIR = Path(__file__).parent / "mappings"
+
+
+@dataclass(frozen=True)
+class CrmMapping:
+    crm: str
+    object_name: str
+    external_id_field: str
+    fields: dict[str, str]
+
+
+def record_values(record: CrmCallRecord) -> dict[str, str | int | float | None]:
+    """The mappable fields of a record by canonical name; providers place them per mapping."""
+    return {
+        "outcome": record.outcome,
+        "booking_masked": record.booking_masked,
+        "qa_score": record.qa_score,
+        "transcript_url": record.transcript_url,
+        "cost_paise": record.cost_paise,
+        "next_action": record.next_action,
+        "owner": record.owner,
+    }
+
+
+def mapped_properties(record: CrmCallRecord, mapping: CrmMapping) -> dict[str, object]:
+    """Target field name -> value, for CRMs whose fields are flat named properties."""
+    values = record_values(record)
+    return {target: values[name] for name, target in mapping.fields.items()}
+
+
+def load_mapping(crm: str, directory: Path = MAPPINGS_DIR) -> CrmMapping:
+    path = directory / f"{crm}.yaml"
+    if not path.exists():
+        raise MappingConfigError(f"no CRM mapping file {path.name}")
+    raw = yaml.safe_load(path.read_text())
+    if not isinstance(raw, dict) or set(raw) != {"object", "external_id_field", "fields"}:
+        raise MappingConfigError(
+            f"{path.name} must have exactly: object, external_id_field, fields"
+        )
+    fields = raw["fields"]
+    if not isinstance(fields, dict):
+        raise MappingConfigError(f"{path.name}: fields must be a mapping")
+    unknown = set(fields) - MAPPABLE
+    if unknown:
+        raise MappingConfigError(f"{path.name}: unknown fields {sorted(unknown)}")
+    missing = MAPPABLE - set(fields)
+    if missing:
+        raise MappingConfigError(f"{path.name}: unmapped fields {sorted(missing)}")
+    if not all(isinstance(v, str) and v for v in fields.values()):
+        raise MappingConfigError(f"{path.name}: every target must be a non-empty string")
+    return CrmMapping(
+        crm=crm,
+        object_name=str(raw["object"]),
+        external_id_field=str(raw["external_id_field"]),
+        fields={str(k): str(v) for k, v in fields.items()},
+    )
