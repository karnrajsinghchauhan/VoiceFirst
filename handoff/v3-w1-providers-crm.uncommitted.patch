+"""Idempotent upserts keyed by call_id, for every CRM, against documented request shapes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import httpx
+import pytest
+
+from app.core.errors import MappingConfigError, ProviderError
+from app.crm.mapping import MAPPABLE, load_mapping
+from app.providers.base import CrmCallRecord
+from app.providers.crm.hubspot import HubSpotCrm, HubSpotSettings
+from app.providers.crm.mock import MockCrm
+from app.providers.crm.salesforce import SalesforceCrm, SalesforceSettings
+from app.providers.crm.zendesk import ZendeskCrm, ZendeskSettings
+
+RECORD = CrmCallRecord(
+    call_id="call_abc",
+    subject="Agoda Voice J1: link_sent (******1234)",
+    body="5 lines",
+    outcome="link_sent",
+    booking_masked="******1234",
+    qa_score=0.92,
+    transcript_url="https://console.example.invalid/console/calls/call_abc",
+    cost_paise=310,
+    next_action="Watch for payment",
+    owner="ai",
+    priority="normal",
+    tags=("agoda_voice", "outcome_link_sent"),
+)
+
+
+@pytest.mark.parametrize("crm", ["mock", "zendesk", "salesforce", "hubspot"])
+def test_every_shipped_mapping_is_complete(crm: str) -> None:
+    assert set(load_mapping(crm).fields) == MAPPABLE
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "object: x\nexternal_id_field: y\nfields: {outcome: a}\n",
+        "object: x\nexternal_id_field: y\nfields: {nonsense: a, "
+        + ", ".join(f"{f}: a" for f in sorted(MAPPABLE))
+        + "}\n",
+        "object: x\nfields: {}\n",
+    ],
+)
+def test_bad_mappings_fail_at_boot(tmp_path: Path, text: str) -> None:
+    (tmp_path / "bad.yaml").write_text(text)
+    with pytest.raises(MappingConfigError):
+        load_mapping("bad", tmp_path)
+
+
+def test_mock_upsert_is_idempotent() -> None:
+    crm = MockCrm()
+    first = crm.upsert_call_record(RECORD)
+    second = crm.upsert_call_record(RECORD)
+    assert first.ticket_id == second.ticket_id and len(crm.tickets) == 1
+
+
+def _zendesk(handler):
+    zs = ZendeskSettings(subdomain="agoda-test", email="bot@example.invalid", api_token="t")
+    return ZendeskCrm(zs, load_mapping("zendesk"), transport=httpx.MockTransport(handler))
+
+
+def test_zendesk_creates_then_updates_the_same_ticket():
+    store: dict[str, int] = {}
+    calls: list[tuple[str, str]] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        calls.append((request.method, request.url.path))
+        if request.method == "GET":
+            ext = request.url.params["external_id"]
+            found = [{"id": store[ext]}] if ext in store else []
+            return httpx.Response(200, json={"tickets": found})
+        body = json.loads(request.content)["ticket"]
+        if request.method == "POST":
+            store[body["external_id"]] = 4242
+            return httpx.Response(201, json={"ticket": {"id": 4242}})
+        return httpx.Response(200, json={"ticket": {"id": 4242}})
+
+    crm = _zendesk(handler)
+    assert crm.upsert_call_record(RECORD).ticket_id == "4242"
+    assert crm.upsert_call_record(RECORD).ticket_id == "4242"
+    assert [m for m, _ in calls] == ["GET", "POST", "GET", "PUT"]
+
+
+def test_zendesk_writes_mapped_custom_fields_and_internal_comment():
+    seen: list[dict[str, object]] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.method == "GET":
+            return httpx.Response(200, json={"tickets": []})
+        seen.append(json.loads(request.content)["ticket"])
+        return httpx.Response(201, json={"ticket": {"id": 1}})
+
+    _zendesk(handler).upsert_call_record(RECORD)
+    ticket = seen[0]
+    fields = {f["id"]: f["value"] for f in ticket["custom_fields"]}  # type: ignore[union-attr]
+    assert fields[9000000001] == "link_sent" and fields[9000000005] == 310
+    assert ticket["comment"] == {"body": "5 lines", "public": False}
+    assert ticket["external_id"] == "call_abc"
+
+
+def test_zendesk_duplicate_tickets_for_a_call_raise():
+    crm = _zendesk(lambda r: httpx.Response(200, json={"tickets": [{"id": 1}, {"id": 2}]}))
+    with pytest.raises(ProviderError):
+        crm.upsert_call_record(RECORD)
+
+
+def _salesforce(handler):
+    s = SalesforceSettings(instance_url="https://agoda.my.salesforce.com", access_token="x")
+    return SalesforceCrm(s, load_mapping("salesforce"), transport=httpx.MockTransport(handler))
+
+
+def test_salesforce_upserts_by_external_id():
+    seen: list[httpx.Request] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(request)
+        return httpx.Response(201, json={"id": "500xx000001", "success": True, "created": True})
+
+    ticket = _salesforce(handler).upsert_call_record(RECORD)
+    req = seen[0]
+    assert req.method == "PATCH"
+    assert req.url.path == "/services/data/v61.0/sobjects/Case/AV_Call_Id__c/call_abc"
+    body = json.loads(req.content)
+    assert body["AV_Outcome__c"] == "link_sent" and body["Priority"] == "Medium"
+    assert ticket.ticket_id == "500xx000001"
+
+
+def test_salesforce_update_fetches_existing_id():
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.method == "PATCH":
+            return httpx.Response(204)
+        return httpx.Response(200, json={"Id": "500xx000009"})
+
+    assert _salesforce(handler).upsert_call_record(RECORD).ticket_id == "500xx000009"
+
+
+def _hubspot(handler):
+    s = HubSpotSettings(access_token="pat-x", portal_id="123")
+    return HubSpotCrm(s, load_mapping("hubspot"), transport=httpx.MockTransport(handler))
+
+
+def test_hubspot_batch_upsert_keyed_by_call_id():
+    seen: list[httpx.Request] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(request)
+        return httpx.Response(200, json={"status": "COMPLETE", "results": [{"id": "88"}]})
+
+    ticket = _hubspot(handler).upsert_call_record(RECORD)
+    body = json.loads(seen[0].content)
+    assert seen[0].url.path == "/crm/v3/objects/tickets/batch/upsert"
+    assert body["inputs"][0]["idProperty"] == "av_call_id" and body["inputs"][0]["id"] == "call_abc"
+    assert body["inputs"][0]["properties"]["av_qa_score"] == 0.92
+    assert ticket.url == "https://app.hubspot.com/contacts/123/ticket/88"
+
+
+@pytest.mark.parametrize("status", [400, 401, 429, 500])
+def test_crm_errors_are_typed(status: int):
+    bad = lambda r: httpx.Response(status, json={})  # noqa: E731
+    for client in (_salesforce(bad), _hubspot(bad)):
+        with pytest.raises(ProviderError):
+            client.upsert_call_record(RECORD)
