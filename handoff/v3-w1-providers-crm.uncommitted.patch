+++ b/server/app/webhooks_out/signing.py
@@ -0,0 +1,58 @@
+"""Signing for outbound webhooks, and the verifier receivers use (S5).
+
+Signature: hex HMAC-SHA256 under the subscription secret over "<timestamp>.<raw body>".
+Headers: X-AV-Signature (v1=<hex>), X-AV-Timestamp (unix seconds), X-AV-Event-Id.
+A receiver rejects a bad signature, a timestamp outside the tolerance, and an event id it
+has already processed; together these stop tampering and replay.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+from collections.abc import Callable, Mapping
+
+from app.core.errors import WebhookReplayError, WebhookSignatureError
+
+SIGNATURE_HEADER = "X-AV-Signature"
+TIMESTAMP_HEADER = "X-AV-Timestamp"
+EVENT_ID_HEADER = "X-AV-Event-Id"
+TOLERANCE_SECONDS = 300
+
+
+def sign(secret: str, timestamp: int, body: bytes) -> str:
+    mac = hmac.new(secret.encode(), f"{timestamp}.".encode() + body, hashlib.sha256)
+    return f"v1={mac.hexdigest()}"
+
+
+def signed_headers(secret: str, timestamp: int, event_id: str, body: bytes) -> dict[str, str]:
+    return {
+        SIGNATURE_HEADER: sign(secret, timestamp, body),
+        TIMESTAMP_HEADER: str(timestamp),
+        EVENT_ID_HEADER: event_id,
+        "Content-Type": "application/json",
+    }
+
+
+def verify(
+    secret: str,
+    headers: Mapping[str, str],
+    body: bytes,
+    now_unix: int,
+    seen: Callable[[str], bool],
+) -> str:
+    """Receiver-side check. Returns the event id; `seen(event_id)` must also record it."""
+    # HTTP header names are case-insensitive and most frameworks lower-case them.
+    lowered = {k.lower(): v for k, v in headers.items()}
+    signature = lowered.get(SIGNATURE_HEADER.lower())
+    ts_raw = lowered.get(TIMESTAMP_HEADER.lower())
+    event_id = lowered.get(EVENT_ID_HEADER.lower())
+    if not signature or not ts_raw or not event_id or not ts_raw.isdigit():
+        raise WebhookSignatureError("missing Agoda Voice signature headers")
+    if not hmac.compare_digest(sign(secret, int(ts_raw), body), signature):
+        raise WebhookSignatureError("signature does not match the body")
+    if abs(now_unix - int(ts_raw)) > TOLERANCE_SECONDS:
+        raise WebhookReplayError("timestamp outside tolerance")
+    if seen(event_id):
+        raise WebhookReplayError(f"event {event_id} already processed")
+    return event_id
