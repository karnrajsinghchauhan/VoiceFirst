@@ -0,0 +1,28 @@
+"""Dead-letter queue for outbound deliveries (CRM sync, outbound webhooks). Nothing is dropped:
+a failed delivery is a row here and a page to a human until someone resolves it."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any, Literal
+
+from sqlalchemy import JSON, Integer, String, Text
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.core.db import Base, UtcDateTime
+
+DeliveryKind = Literal["crm", "webhook"]
+
+
+class DeadLetterRow(Base):
+    __tablename__ = "delivery_dead_letters"
+    dlq_id: Mapped[str] = mapped_column(String, primary_key=True)
+    kind: Mapped[DeliveryKind] = mapped_column(String, index=True)
+    key: Mapped[str] = mapped_column(String, index=True)  # call_id, or event id for webhooks
+    target: Mapped[str] = mapped_column(String)  # crm name or subscription id
+    payload: Mapped[dict[str, Any]] = mapped_column(JSON)
+    error: Mapped[str] = mapped_column(Text)
+    attempts: Mapped[int] = mapped_column(Integer)
+    created_at: Mapped[datetime] = mapped_column(UtcDateTime, index=True)
+    last_attempt_at: Mapped[datetime] = mapped_column(UtcDateTime)
+    resolved_at: Mapped[datetime | None] = mapped_column(UtcDateTime, nullable=True)
