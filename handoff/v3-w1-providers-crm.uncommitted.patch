+
+from app.core.errors import ConfigError, ProviderError, ProviderTimeoutError
+from app.crm.mapping import CrmMapping, mapped_properties
+from app.providers.base import CrmCallRecord, CrmTicket
+
+_PRIORITY = {"low": "Low", "normal": "Medium", "high": "High", "urgent": "High"}
+
+
+class SalesforceSettings(BaseSettings):
+    model_config = SettingsConfigDict(env_prefix="AV_SALESFORCE_", extra="ignore", frozen=True)
+
+    instance_url: str = ""
+    access_token: str = ""
+    api_version: str = "v61.0"
+    timeout_seconds: float = 10.0
+
+    def require_complete(self) -> None:
+        missing = [k for k in ("instance_url", "access_token") if not getattr(self, k)]
+        if missing:
+            raise ConfigError(
+                f"salesforce settings missing: {['AV_SALESFORCE_' + m.upper() for m in missing]}"
+            )
+
+
+class _Id(BaseModel):
+    model_config = ConfigDict(extra="ignore", populate_by_name=True)
+    id: str
+
+
+class _Record(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+    Id: str
+
+
+class SalesforceCrm:
+    name = "salesforce"
+
+    def __init__(
+        self,
+        settings: SalesforceSettings,
+        mapping: CrmMapping,
+        transport: httpx.BaseTransport | None = None,
+    ) -> None:
+        settings.require_complete()
+        self._mapping = mapping
+        self._instance = settings.instance_url.rstrip("/")
+        self._client = httpx.Client(
+            base_url=f"{self._instance}/services/data/{settings.api_version}",
+            headers={"Authorization": f"Bearer {settings.access_token}"},
+            timeout=settings.timeout_seconds,
+            transport=transport,
+        )
+
+    def _request(
+        self, method: str, path: str, body: Mapping[str, object] | None = None
+    ) -> httpx.Response:
+        try:
+            response = self._client.request(method, path, json=body)
+        except httpx.TimeoutException as exc:
+            raise ProviderTimeoutError(f"salesforce {method} {path} timed out") from exc
+        except httpx.HTTPError as exc:
+            raise ProviderError(f"salesforce {method} {path} failed: {exc}") from exc
+        if response.status_code not in (200, 201, 204):
+            raise ProviderError(f"salesforce {method} {path} returned {response.status_code}")
+        return response
+
+    def _upsert(self, call_id: str, fields: dict[str, object]) -> CrmTicket:
+        path = f"/sobjects/{self._mapping.object_name}/{self._mapping.external_id_field}/{call_id}"
+        response = self._request("PATCH", path, fields)
+        try:
+            if response.status_code == 201:
+                record_id = _Id.model_validate_json(response.content).id
+            else:  # 200/204: updated an existing record; fetch its Id for the link
+                record_id = _Record.model_validate_json(self._request("GET", path).content).Id
+        except ValidationError as exc:
+            raise ProviderError("salesforce returned an unexpected upsert body") from exc
+        return CrmTicket(ticket_id=record_id, url=f"{self._instance}/lightning/r/{record_id}/view")
+
+    def upsert_call_record(self, record: CrmCallRecord) -> CrmTicket:
+        fields: dict[str, object] = {
+            "Subject": record.subject,
+            "Description": record.body,
+            "Priority": _PRIORITY[record.priority],
+            "Origin": "Agoda Voice",
+            **mapped_properties(record, self._mapping),
+        }
+        return self._upsert(record.call_id, fields)
+
+    def create_ticket(
+        self, subject: str, body: str, requester_ref: str, tags: list[str], priority: str
+    ) -> CrmTicket:
+        # requester_ref is the call_id: a case opened at handoff is the same record the
+        # post-call sync later updates.
+        fields: dict[str, object] = {
+            "Subject": subject,
+            "Description": body,
+            "Priority": _PRIORITY[priority],
+            "Origin": "Agoda Voice",
+        }
+        return self._upsert(requester_ref, fields)
+
+    def add_note(self, ticket_id: str, body: str) -> None:
+        self._request("POST", "/sobjects/FeedItem", {"ParentId": ticket_id, "Body": body})
