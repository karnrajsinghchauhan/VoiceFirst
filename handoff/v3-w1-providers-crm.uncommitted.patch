+            base_url=API,
+            headers={"Authorization": f"Bearer {settings.access_token}"},
+            timeout=settings.timeout_seconds,
+            transport=transport,
+        )
+
+    def _request(self, method: str, path: str, body: Mapping[str, object]) -> httpx.Response:
+        try:
+            response = self._client.request(method, path, json=body)
+        except httpx.TimeoutException as exc:
+            raise ProviderTimeoutError(f"hubspot {method} {path} timed out") from exc
+        except httpx.HTTPError as exc:
+            raise ProviderError(f"hubspot {method} {path} failed: {exc}") from exc
+        if response.status_code not in (200, 201):
+            raise ProviderError(f"hubspot {method} {path} returned {response.status_code}")
+        return response
+
+    def _upsert(self, call_id: str, properties: dict[str, object]) -> CrmTicket:
+        body = {
+            "inputs": [
+                {
+                    "idProperty": self._mapping.external_id_field,
+                    "id": call_id,
+                    "properties": properties,
+                }
+            ]
+        }
+        response = self._request("POST", "/crm/v3/objects/tickets/batch/upsert", body)
+        try:
+            results = _Batch.model_validate_json(response.content).results
+        except ValidationError as exc:
+            raise ProviderError("hubspot returned an unexpected upsert body") from exc
+        if len(results) != 1:
+            raise ProviderError(f"hubspot upsert returned {len(results)} results for one call")
