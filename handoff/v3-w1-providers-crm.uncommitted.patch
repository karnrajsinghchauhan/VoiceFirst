+"""Post-call sync: one record per handled call; an outage dead-letters, pages, and replays."""
+
+from __future__ import annotations
+
+from app.core.ids import mask_booking_id
+from app.crm.retry_dlq import retry_crm
+from app.crm.sync import HANDLED, build_record, deliver
+from app.delivery.dlq import open_items
+from app.incidents.service import list_open
+from app.providers.crm.mock import MockCrm
+from app.simulator.caller import load_personas
+from app.simulator.scenario import run_text
+
+
+def _outcome(settings, persona_id: str = "C-01"):
+    persona = next(p for p in load_personas() if p.id == persona_id)
+    run = run_text(settings, persona, "hinglish", 0)
+    return run.result.outcome, run.result.handoff_summary, run.event
+
+
+def test_record_carries_everything_the_brief_lists(settings):
+    outcome, summary, event = _outcome(settings, "C-05")
+    # The simulator derives call ids from booking ids; production call ids are random.
+    outcome = outcome.model_copy(update={"call_id": "call_0f9e"})
+    record = build_record(
+        outcome, summary, mask_booking_id(event.booking_id), 0.8, "https://console.example.invalid"
+    )
+    assert record.call_id == outcome.call_id and record.outcome == outcome.outcome
+    assert record.booking_masked.endswith(event.booking_id[-4:])
+    assert event.booking_id not in record.body
+    assert record.transcript_url.endswith(f"/console/calls/{outcome.call_id}")
+    assert record.qa_score == 0.8 and record.next_action and record.owner
+    assert "Grievance channel" in record.body
+
+
+def test_outage_dead_letters_pages_then_replays(session, settings, clock):
+    outcome, summary, event = _outcome(settings)
+    assert outcome.outcome in HANDLED
+    record = build_record(
+        outcome, summary, mask_booking_id(event.booking_id), None, "https://console.example.invalid"
+    )
+    crm = MockCrm(fail_upserts=True)
+    assert deliver(session, crm, settings, clock, record) == "dead_lettered"
+    assert deliver(session, crm, settings, clock, record) == "dead_lettered"
+    [row] = open_items(session, "crm")
+    assert row.attempts == 2 and row.key == outcome.call_id
+    assert sum("crm delivery" in i.summary for i in list_open(session, settings.tenant_id)) == 1
+    crm.fail_upserts = False
+    report = retry_crm(session, crm, clock)
+    assert (report.retried, report.resolved, report.still_failing) == (1, 1, 0)
+    assert open_items(session, "crm") == [] and crm.upserts == 1
+
+
+def test_written_when_crm_is_up(session, settings, clock):
+    outcome, summary, event = _outcome(settings)
+    record = build_record(
+        outcome, summary, mask_booking_id(event.booking_id), None, "https://console.example.invalid"
+    )
+    crm = MockCrm()
+    assert deliver(session, crm, settings, clock, record) == "written"
+    assert open_items(session, "crm") == []
