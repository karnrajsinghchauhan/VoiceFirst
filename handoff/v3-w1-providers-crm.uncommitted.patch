+        url = f"https://app.hubspot.com/contacts/{self._settings.portal_id}/ticket/{ticket_id}"
+        return CrmTicket(ticket_id=ticket_id, url=url)
+
+    def _base_properties(self, subject: str, body: str, priority: str) -> dict[str, object]:
+        return {
+            "subject": subject,
+            "content": body,
+            "hs_ticket_priority": _PRIORITY[priority],
+            "hs_pipeline": self._settings.pipeline,
+            "hs_pipeline_stage": self._settings.pipeline_stage,
+        }
+
+    def upsert_call_record(self, record: CrmCallRecord) -> CrmTicket:
+        properties = {
+            **self._base_properties(record.subject, record.body, record.priority),
+            **mapped_properties(record, self._mapping),
+        }
+        return self._upsert(record.call_id, properties)
+
+    def create_ticket(
+        self, subject: str, body: str, requester_ref: str, tags: list[str], priority: str
+    ) -> CrmTicket:
+        # Keyed by call_id like the post-call sync, so a handoff case is the same ticket.
+        return self._upsert(requester_ref, self._base_properties(subject, body, priority))
+
+    def add_note(self, ticket_id: str, body: str) -> None:
+        self._request(
+            "POST",
+            "/crm/v3/objects/notes",
+            {
+                "properties": {"hs_note_body": body},
+                "associations": [
+                    {
+                        "to": {"id": ticket_id},
+                        "types": [
+                            {
+                                "associationCategory": "HUBSPOT_DEFINED",
+                                "associationTypeId": NOTE_TO_TICKET_ASSOCIATION,
+                            }
+                        ],
+                    }
+                ],
+            },
+        )
