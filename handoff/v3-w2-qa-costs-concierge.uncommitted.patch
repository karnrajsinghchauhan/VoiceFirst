diff --git a/server/app/concierge/answer.py b/server/app/concierge/answer.py
new file mode 100644
index 0000000..69282b6
--- /dev/null
+++ b/server/app/concierge/answer.py
@@ -0,0 +1,154 @@
+"""The concierge: answers questions about the product from the public corpus, with citations.
+
+Order of decisions, each a deterministic rule so it can be tested:
+1. Prompt injection or an unrelated task -> refuse, stay on topic, offer a call.
+2. Questions about customers, certifications or partnerships -> the honest answer
+   (none are claimed), because the corpus must never be stretched into an invented one.
+3. Retrieval. Weak retrieval -> say so and offer a call. Otherwise quote the best passage
+   and cite its page. Prices therefore only ever come from the docs and cost book.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Literal
+
+from app.concierge.bm25 import Bm25Index, Hit, tokens
+from app.concierge.corpus import Passage, load_corpus
+from app.core.redaction import redact_text
+
+Confidence = Literal["high", "low"]
+Kind = Literal["answer", "unsure", "refused", "honest_none"]
+
+_INJECTION = re.compile(
+    r"ignore (all |the |your |previous |prior )*(instructions|rules|prompt)|system prompt|"
+    r"you are now|pretend (to be|you are)|jailbreak|developer mode|reveal your|act as (a|an|my)|"
+    r"disregard (the|your|all)|new instructions|print your (rules|prompt|instructions)",
+    re.IGNORECASE,
+)
+_OFF_TOPIC = re.compile(
+    r"\b(poem|song|joke|recipe|weather|stock price|bitcoin|crypto|homework|essay|translate this|"
+    r"write (me )?(a |some )?(code|python|javascript|sql|story)|cricket score|horoscope|"
+    r"book (a|me a) (flight|hotel)|hotel in|cheapest flight)\b",
+    re.IGNORECASE,
+)
+_CUSTOMERS = re.compile(
+    r"\b(your (customers?|clients?|users)|which (customers?|clients?|companies)|"
+    r"who (uses|is using)|case stud(y|ies)|testimonials?|customer logos?|references?|"
+    r"already using|customer list|name (a|some|your) (customers?|clients?))\b",
+    re.IGNORECASE,
+)
+_CERTS = re.compile(
+    r"\b(soc ?2|iso ?27001|iso certified|pci(-| )?dss certified|hipaa|certified|certification|"
+    r"accredit\w*|audited by)\b",
+    re.IGNORECASE,
+)
+_PARTNERS = re.compile(
+    r"\b(partner(ed|ship)? with|endorsed|affiliated|official agoda)\b", re.IGNORECASE
+)
+
+# Below this idf-weighted share of the question's terms found in the best passage, the corpus
+# does not answer the question; saying "not sure" beats guessing.
+MIN_COVERAGE = 0.45
+_SENTENCE = re.compile(r"(?<=[.!?])\s+")
+
+BOOK = {"type": "book_meeting"}
+
+
+@dataclass(frozen=True)
+class Citation:
+    title: str
+    url: str
+
+
+@dataclass(frozen=True)
+class ConciergeAnswer:
+    answer: str
+    citations: tuple[Citation, ...]
+    confidence: Confidence
+    kind: Kind
+    actions: tuple[dict[str, str], ...] = field(default_factory=tuple)
+
+
+def _best_sentences(hits: list[Hit], query: str, limit: int = 2) -> tuple[str, list[Hit]]:
+    """The sentences that share the most terms with the question, and the hits they came from."""
+    q = set(tokens(query))
+    candidates = [
+        (len(q & set(tokens(s))), -rank, s.strip(), h)
+        for rank, h in enumerate(hits)
+        for s in _SENTENCE.split(h.passage.text)
+        if len(s.strip()) > 20
+    ]
+    chosen = sorted(candidates, reverse=True)[:limit]
+    if not chosen:
+        return hits[0].passage.text[:300], hits[:1]
+    used = [h for h in hits if any(c[3] is h for c in chosen)]
+    return " ".join(c[2] for c in chosen), used
+
+
+def _cite(hits: list[Hit]) -> tuple[Citation, ...]:
+    seen: dict[str, Citation] = {}
+    for h in hits:
+        title = (
+            h.passage.page_title
+            if h.passage.section == h.passage.page_title
+            else (f"{h.passage.page_title}: {h.passage.section}")
+        )
+        seen.setdefault(h.passage.url, Citation(title, h.passage.url))
+    return tuple(seen.values())[:2]
+
+
+class Concierge:
+    def __init__(self, passages: list[Passage] | None = None) -> None:
+        self._index = Bm25Index(passages if passages is not None else load_corpus())
+
+    def ask(self, message: str) -> ConciergeAnswer:
+        # PII minimisation: nothing below sees an email, phone or card number.
+        text = redact_text(message)
+        if _INJECTION.search(text) or _OFF_TOPIC.search(text):
+            return ConciergeAnswer(
+                "I can only help with questions about this product: how calls work, "
+                "compliance, security, deployment and pricing. Would you like to book a call "
+                "with the team?",
+                (),
+                "low",
+                "refused",
+                (BOOK,),
+            )
+        if _CUSTOMERS.search(text) or _PARTNERS.search(text):
+            return ConciergeAnswer(
+                "I can't name customers, partners or endorsements: none are listed on our pages, "
+                "and the product is not affiliated with or endorsed by Agoda. The team can talk "
+                "about pilot status on a call.",
+                (),
+                "low",
+                "honest_none",
+                (BOOK,),
+            )
+        hits = self._index.search(text, k=5)
+        if _CERTS.search(text):
+            security = [
+                h
+                for h in self._index.search("security controls", k=5)
+                if h.passage.url.startswith("/security")
+            ][:1]
+            return ConciergeAnswer(
+                "No certification is claimed. The security page lists the controls we run and "
+                "which ones are planned; the team can share the questionnaire answers.",
+                _cite(security),
+                "high" if security else "low",
+                "honest_none",
+                (BOOK,),
+            )
+        eligible = [h for h in hits if h.coverage >= MIN_COVERAGE]
+        if not eligible:
+            return ConciergeAnswer(
+                "I'm not sure, and I'd rather not guess. The team can answer that on a call.",
+                (),
+                "low",
+                "unsure",
+                (BOOK,),
+            )
+        answer, used = _best_sentences(eligible[:2], text)
+        return ConciergeAnswer(answer, _cite(used), "high", "answer")
diff --git a/server/app/concierge/bm25.py b/server/app/concierge/bm25.py
new file mode 100644
index 0000000..d6a38e6
--- /dev/null
+++ b/server/app/concierge/bm25.py
@@ -0,0 +1,107 @@
+"""Okapi BM25 over passages, plus query coverage. Local, deterministic, no network."""
+
+from __future__ import annotations
+
+import math
+import re
+from collections import Counter
+from dataclasses import dataclass
+
+from app.concierge.corpus import Passage
+
+_TOKEN = re.compile(r"[a-z0-9]+")
+_STOP = frozenset(
+    "a an the and or of to in on for is are be it this that with as by at from do does can you "
+    "your we our i my me what how which who when where why will would should there their them "
+    "about any if not no us it's its tell much many get work works use used using".split()
+)
+
+
+def _stem(t: str) -> str:
+    # Plural folding only: enough to match "CRMs" with "CRM" without a stemming library.
+    return t[:-1] if len(t) > 3 and t.endswith("s") and not t.endswith("ss") else t
+
+
+def tokens(text: str) -> list[str]:
+    return [_stem(t) for t in _TOKEN.findall(text.lower()) if t not in _STOP]
+
+
+# Visitors ask in their words, the docs answer in ours. Each query term also matches these
+# corpus terms (one direction only, applied after stemming).
+EXPANSIONS: dict[str, tuple[str, ...]] = {
+    "stack": ("architecture", "python", "fastapi"),
+    "built": ("architecture", "python"),
+    "engine": ("architecture",),
+    "local": ("quickstart", "make"),
+    "locally": ("quickstart", "make"),
+    "run": ("quickstart",),
+    "configuration": ("config", "environment", "variable", "setting"),
+    "configure": ("config", "environment", "setting"),
+    "set": ("setting",),
+    "release": ("gate", "regression"),
+    "block": ("fail",),
+    "test": ("tester", "persona", "eval"),
+    "integrate": ("crm", "integration"),
+    "obligation": ("report", "log"),
+    "order": ("pipeline",),
+    "gate": ("pipeline",),
+    "immediately": ("now",),
+    "handle": ("declared",),
+    "declaration": ("declared",),
+    "depend": ("outside",),
+    "behaving": ("misbehave",),
+    "model": ("model",),
+    "defined": ("source", "truth", "schema"),
+}
+
+
+def expand(term: str) -> tuple[str, ...]:
+    return (term, *EXPANSIONS.get(term, ()))
+
+
+@dataclass(frozen=True)
+class Hit:
+    passage: Passage
+    score: float
+    coverage: float  # idf-weighted share of the query's terms found in the passage
+
+
+class Bm25Index:
+    def __init__(self, passages: list[Passage], k1: float = 1.2, b: float = 0.4) -> None:
+        self._passages = passages
+        # Page title and section name the topic, so they count twice.
+        self._docs = [
+            Counter(tokens(f"{p.page_title} {p.page_title} {p.section} {p.section} {p.text}"))
+            for p in passages
+        ]
+        self._headings = [set(tokens(f"{p.page_title} {p.section}")) for p in passages]
+        self._lengths = [sum(d.values()) for d in self._docs]
+        self._avg = sum(self._lengths) / len(self._lengths)
+        df: Counter[str] = Counter()
+        for d in self._docs:
+            df.update(d.keys())
+        self._n = len(self._docs)
+        self._idf = {t: math.log(1 + (self._n - f + 0.5) / (f + 0.5)) for t, f in df.items()}
+        self._k1, self._b = k1, b
+
+    def _idf_of(self, term: str) -> float:
+        # A term the corpus never uses is the most informative of all: the answer is not here.
+        return self._idf.get(term, math.log(1 + (self._n + 0.5) / 0.5))
+
+    def search(self, query: str, k: int = 3) -> list[Hit]:
+        q = list(dict.fromkeys(tokens(query)))
+        total = sum(self._idf_of(t) for t in q) or 1.0
+        scored = []
+        for i, doc in enumerate(self._docs):
+            norm = self._k1 * (1 - self._b + self._b * self._lengths[i] / self._avg)
+            covered = [t for t in q if any(v in doc for v in expand(t))]
+            if not covered:
+                continue
+            terms = {v for t in covered for v in expand(t) if v in doc}
+            s = sum(self._idf[v] * doc[v] * (self._k1 + 1) / (doc[v] + norm) for v in terms)
+            # A heading that names the asked-about topic is the strongest signal of the answer.
+            s += sum(2 * self._idf[v] for v in terms if v in self._headings[i])
+            coverage = sum(self._idf_of(t) for t in covered) / total
+            scored.append(Hit(self._passages[i], s, coverage))
+        scored.sort(key=lambda h: h.score, reverse=True)
+        return scored[:k]
