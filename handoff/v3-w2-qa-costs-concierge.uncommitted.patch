@@ -0,0 +1,166 @@
+"""Meeting booking and lead capture for the concierge (S9).
+
+One calendar per deployment, chosen by config: the deterministic mock now, Cal.com later.
+A lead reaches the CRM only with the visitor's recorded opt-in; the consent text and time
+are stored with the lead.
+"""
+
+from __future__ import annotations
+
+import re
+import time
+from collections import deque
+from dataclasses import dataclass, field
+from datetime import UTC, date, datetime, timedelta
+from datetime import time as dtime
+from typing import Protocol
+from zoneinfo import ZoneInfo
+
+from sqlalchemy import String, Text
+from sqlalchemy.orm import Mapped, Session, mapped_column
+
+from app.core.db import Base, UtcDateTime
+from app.core.errors import (
+    ConsentRequiredError,
+    InvalidInputError,
+    NotBuiltYetError,
+    RateLimitedError,
+    StateConflictError,
+)
+from app.core.ids import new_id
+from app.providers.base import CrmProvider
+
+IST = ZoneInfo("Asia/Kolkata")
+CONSENT_TEXT = (
+    "I agree that ProsperOps may store my name, email and company to arrange this call and "
+    "contact me about it. I can withdraw at any time by replying STOP or emailing privacy@."
+)
+_EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+
+
+class Calendar(Protocol):
+    def slots(self, after: datetime) -> list[datetime]: ...
+
+    def book(self, slot: datetime, name: str, email: str) -> str: ...
+
+
+@dataclass
+class MockCalendar:
+    """Weekdays at 11:00 and 16:00 IST, the next five working days. Deterministic."""
+
+    booked: dict[datetime, str] = field(default_factory=dict)
+
+    def slots(self, after: datetime) -> list[datetime]:
+        out: list[datetime] = []
+        day: date = after.astimezone(IST).date() + timedelta(days=1)
+        while len(out) < 10:
+            if day.weekday() < 5:
+                for hour in (11, 16):
+                    slot = datetime.combine(day, dtime(hour), IST).astimezone(UTC)
+                    if slot not in self.booked:
+                        out.append(slot)
+            day += timedelta(days=1)
+        return out
+
+    def book(self, slot: datetime, name: str, email: str) -> str:
+        if slot in self.booked:
+            raise StateConflictError("that slot was just taken; pick another")
+        booking_id = new_id("mtg")
+        self.booked[slot] = booking_id
+        return booking_id
+
+
+class CalComCalendar:
+    def slots(self, after: datetime) -> list[datetime]:
+        raise NotBuiltYetError("AV-CAL-1: Cal.com calendar adapter")
+
+    def book(self, slot: datetime, name: str, email: str) -> str:
+        raise NotBuiltYetError("AV-CAL-1: Cal.com calendar adapter")
+
+
+# Public endpoints (concierge, booking, demo): 30 requests a minute per visitor.
+PUBLIC_RATE_LIMIT = 30
+PUBLIC_RATE_WINDOW_S = 60.0
+
+
+class RateLimiter:
+    """Sliding window per key. In-process: one API replica serves the public site in the pilot."""
+
+    def __init__(self, limit: int, window_s: float) -> None:
+        self._limit = limit
+        self._window = window_s
+        self._hits: dict[str, deque[float]] = {}
+
+    def check(self, key: str, now: float | None = None) -> None:
+        t = time.monotonic() if now is None else now
+        hits = self._hits.setdefault(key, deque())
+        while hits and t - hits[0] > self._window:
+            hits.popleft()
+        if len(hits) >= self._limit:
+            raise RateLimitedError("too many requests; try again in a minute")
+        hits.append(t)
+
+
+class LeadRow(Base):
+    __tablename__ = "concierge_leads"
+    lead_id: Mapped[str] = mapped_column(String, primary_key=True)
+    session_id: Mapped[str] = mapped_column(String, index=True)
+    name: Mapped[str] = mapped_column(String)
+    email: Mapped[str] = mapped_column(String)
+    company: Mapped[str] = mapped_column(String)
+    slot: Mapped[datetime] = mapped_column(UtcDateTime)
+    meeting_id: Mapped[str] = mapped_column(String)
+    crm_ticket_id: Mapped[str] = mapped_column(String)
+    consent_text: Mapped[str] = mapped_column(Text)
+    consent_at: Mapped[datetime] = mapped_column(UtcDateTime)
+
+
+@dataclass(frozen=True)
+class Booked:
+    booking_id: str
+    slot: datetime
+
+
+def book_meeting(
+    session: Session,
+    calendar: Calendar,
+    crm: CrmProvider,
+    *,
+    session_id: str,
+    name: str,
+    email: str,
+    company: str,
+    slot: datetime,
+    consent: bool,
+    now: datetime,
+) -> Booked:
+    if not consent:
+        raise ConsentRequiredError("booking needs the visitor's opt-in to store their details")
+    if not _EMAIL.match(email):
+        raise InvalidInputError("that email address does not look valid")
+    if slot not in calendar.slots(now - timedelta(days=1)):
+        raise StateConflictError("that slot is not offered (taken or past)")
+    meeting_id = calendar.book(slot, name, email)
+    ticket = crm.create_ticket(
+        subject=f"Concierge lead: {company}",
+        body=f"Meeting {meeting_id} at {slot.isoformat()}. Consent recorded {now.isoformat()}.",
+        requester_ref=email,
+        tags=["concierge", "lead", "consented"],
+        priority="normal",
+    )
+    session.add(
+        LeadRow(
+            lead_id=new_id("lead"),
+            session_id=session_id,
+            name=name,
+            email=email,
+            company=company,
+            slot=slot,
+            meeting_id=meeting_id,
+            crm_ticket_id=ticket.ticket_id,
+            consent_text=CONSENT_TEXT,
+            consent_at=now,
+        )
+    )
+    session.flush()
+    return Booked(meeting_id, slot)
