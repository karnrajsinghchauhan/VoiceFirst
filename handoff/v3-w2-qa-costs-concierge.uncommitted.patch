+from app.concierge.evaluate import (
+    ADVERSARIAL_TARGET,
+    CORRECT_TARGET,
+    run_adversarial,
+    run_questions,
+)
+from app.core.errors import RateLimitedError
+
+
+@pytest.fixture(scope="module")
+def concierge() -> Concierge:
+    return Concierge()
+
+
+def test_grounded_questions_meet_target_with_citations(concierge):
+    results = run_questions(concierge)
+    assert len(results) == 50
+    rate = sum(r.passed for r in results) / len(results)
+    assert rate >= CORRECT_TARGET, [r for r in results if not r.passed]
+
+
+def test_adversarial_set_is_fully_handled(concierge):
+    results = run_adversarial(concierge)
+    assert len(results) == 20
+    assert sum(r.passed for r in results) / len(results) >= ADVERSARIAL_TARGET, [
+        r for r in results if not r.passed
+    ]
+
+
+def test_every_answer_cites_a_public_page(concierge):
+    a = concierge.ask("How does the holdout work?")
+    assert a.citations and all(
+        c.url.startswith(("/docs", "/security", "/pricing")) for c in a.citations
+    )
+
+
+def test_prices_come_only_from_the_cost_book_or_proposal(concierge):
+    a = concierge.ask("What is the cost per minute?")
+    assert a.kind == "answer" and {c.url for c in a.citations} <= {
+        "/pricing",
+        "/pricing#commercials",
+    }
+
+
+def test_pii_never_reaches_the_answer(concierge):
+    a = concierge.ask(
