+"""Public concierge endpoints (S9). No bearer token: rate-limited per client address and session."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Literal
+
+from fastapi import APIRouter, Request
+from pydantic import BaseModel, ConfigDict, Field
+
+from app.api.deps import Db, Deps
+from app.api.types import IsoDatetime
+from app.concierge.booking import CONSENT_TEXT, book_meeting
+from app.core.logging import get_logger
+from app.core.redaction import redact_text
+
+router = APIRouter()
+_log = get_logger(__name__)
+
+
+class _In(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+
+class AskIn(_In):
+    session_id: str = Field(min_length=8, max_length=64, pattern=r"^[A-Za-z0-9_-]+$")
+    message: str = Field(min_length=1, max_length=1000)
+
+
+class CitationOut(BaseModel):
+    title: str
+    url: str
+
+
+class ActionOut(BaseModel):
+    type: Literal["book_meeting"]
+
+
+class AskOut(BaseModel):
+    answer: str
+    citations: list[CitationOut]
+    confidence: Literal["high", "low"]
+    actions: list[ActionOut]
+
+
+class SlotsOut(BaseModel):
+    slots: list[datetime]
+    timezone: Literal["Asia/Kolkata"]
+    consent_text: str
+
+
+class BookIn(_In):
+    session_id: str = Field(min_length=8, max_length=64, pattern=r"^[A-Za-z0-9_-]+$")
+    name: str = Field(min_length=1, max_length=120)
+    email: str = Field(min_length=3, max_length=254, pattern=r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+    company: str = Field(min_length=1, max_length=160)
+    slot: IsoDatetime
+    # The opt-in is part of the contract: a booking without it is not a valid request.
+    consent: Literal[True]
+
+
+class BookOut(BaseModel):
+    booking_id: str
+    slot: datetime
+
+
+def _limit(deps: Deps, request: Request, session_id: str) -> None:
+    client = request.client.host if request.client else "unknown"
+    deps.public_limiter.check(f"ip:{client}")
+    deps.public_limiter.check(f"session:{session_id}")
+
+
+@router.post("/concierge/ask", tags=["concierge"])
+def ask(body: AskIn, deps: Deps, request: Request) -> AskOut:
+    _limit(deps, request, body.session_id)
+    a = deps.concierge.ask(body.message)
+    # Only the redacted question is logged (PII minimisation); nothing is stored.
+    _log.info(
+        "concierge ask",
+        extra={"session": body.session_id, "kind": a.kind, "question": redact_text(body.message)},
+    )
+    return AskOut(
+        answer=a.answer,
+        citations=[CitationOut(title=c.title, url=c.url) for c in a.citations],
+        confidence=a.confidence,
+        actions=[ActionOut(type="book_meeting") for _ in a.actions],
+    )
+
+
+@router.get("/concierge/slots", tags=["concierge"])
+def slots(deps: Deps, request: Request) -> SlotsOut:
+    _limit(deps, request, "slots")
+    return SlotsOut(
+        slots=deps.calendar.slots(deps.clock.now()),
+        timezone="Asia/Kolkata",
+        consent_text=CONSENT_TEXT,
+    )
+
+
+@router.post("/concierge/book", tags=["concierge"])
+def book(body: BookIn, deps: Deps, db: Db, request: Request) -> BookOut:
+    _limit(deps, request, body.session_id)
+    booked = book_meeting(
+        db,
+        deps.calendar,
+        deps.crm,
+        session_id=body.session_id,
+        name=body.name,
+        email=body.email,
+        company=body.company,
+        slot=body.slot,
+        consent=body.consent,
+        now=deps.clock.now(),
+    )
+    return BookOut(booking_id=booked.booking_id, slot=booked.slot)
