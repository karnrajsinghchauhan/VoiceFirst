+"""The concierge's only knowledge: public docs pages, the trust documents and pricing.
+
+Each document is split into passages at "##" headings so a citation can point at a section.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+
+# Repository documents that back a public page. The URL is where a visitor reads it.
+_REPO_DOCS: tuple[tuple[str, str], ...] = (
+    ("SECURITY.md", "/security"),
+    ("docs/subprocessors.md", "/security#subprocessors"),
+    ("docs/licences.md", "/security#licences"),
+    ("docs/threat-model.md", "/security#threat-model"),
+    ("docs/unit-economics.md", "/pricing"),
+    ("docs/proposal-draft.md", "/pricing#commercials"),
+    ("docs/sizing.md", "/docs/private-deployment#sizing"),
+)
+
+
+@dataclass(frozen=True)
+class Passage:
+    page_title: str
+    section: str
+    url: str
+    text: str
+
+
+def _title(markdown: str, fallback: str) -> str:
+    match = re.search(r"^#\s+(.+)$", markdown, re.MULTILINE)
+    return match.group(1).strip() if match else fallback
+
+
+def _table_rows_to_sentences(text: str) -> str:
+    out = []
+    for line in text.splitlines():
+        stripped = line.strip()
+        if re.fullmatch(r"\|?[\s:|-]+\|?", stripped) and "-" in stripped:
+            continue  # table separator row
+        if stripped.startswith("|") and stripped.endswith("|"):
+            cells = [c.strip() for c in stripped.strip("|").split("|") if c.strip()]
+            out.append(
+                ": ".join(cells[:1]) + (" - " + "; ".join(cells[1:]) if cells[1:] else "") + "."
+            )
+            continue
+        out.append(line)
+    return "\n".join(out)
+
+
+def _clean(text: str) -> str:
+    text = _table_rows_to_sentences(text)
+    text = re.sub(r"```.*?```", " ", text, flags=re.DOTALL)
+    text = re.sub(r"<[^>]+>", " ", text)  # MDX/JSX tags carry no answer text
+    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
+    text = re.sub(r"[*_`|]", " ", text)
+    return re.sub(r"[ \t]+", " ", text).strip()
+
+
+def split(markdown: str, url: str, fallback_title: str) -> list[Passage]:
+    title = _title(markdown, fallback_title)
+    parts = re.split(r"^##\s+", markdown, flags=re.MULTILINE)
+    passages = []
+    for i, part in enumerate(parts):
+        heading, _, body = part.partition("\n") if i else ("", "", part)
+        text = _clean(body if i else re.sub(r"^#\s+.+$", "", part, flags=re.MULTILINE))
+        if len(text) < 120:
+            continue
+        section = heading.strip() or title
+        passages.append(Passage(title, section, url, text))
+    return passages
+
+
+def load_corpus(root: Path = ROOT) -> list[Passage]:
+    passages: list[Passage] = []
+    docs = root / "web/src/app/docs"
+    for page in sorted(docs.rglob("page.mdx")):
+        slug = page.parent.relative_to(docs).as_posix()
+        url = "/docs" if slug == "." else f"/docs/{slug}"
+        passages += split(page.read_text(encoding="utf-8"), url, slug)
+    for rel, url in _REPO_DOCS:
+        passages += split((root / rel).read_text(encoding="utf-8"), url, rel)
+    return passages
