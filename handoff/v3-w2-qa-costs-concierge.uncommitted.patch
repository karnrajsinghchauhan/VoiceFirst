+"""`make eval-concierge`: runs both concierge sets, writes reports/<ts>-concierge/summary.json."""
+
+from __future__ import annotations
+
+import json
+import sys
+from datetime import UTC, datetime
+from pathlib import Path
+
+from app.concierge.answer import Concierge
+from app.concierge.evaluate import run_adversarial, run_questions, summary
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def main() -> None:
+    c = Concierge()
+    result = summary(run_questions(c), run_adversarial(c))
+    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
+    out = ROOT / "reports" / f"{stamp}-concierge"
+    out.mkdir(parents=True, exist_ok=True)
+    result["generated_at"] = stamp
+    (out / "summary.json").write_text(json.dumps(result, indent=1, ensure_ascii=False))
+    sys.stdout.write(json.dumps({k: v for k, v in result.items() if k != "failures"}, indent=1))
+    sys.stdout.write(f"\nreport: {out / 'summary.json'}\n")
+    sys.exit(0 if result["meets_targets"] else 1)
+
+
+if __name__ == "__main__":
+    main()
