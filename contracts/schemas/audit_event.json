{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_event.json",
  "title": "AuditEvent",
  "description": "One privileged action. Append-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "trace_id", "audit_id", "at", "actor", "role", "action", "target", "reason"],
  "properties": {
    "schema_version": {"$ref": "common.json#/$defs/SchemaVersion"},
    "tenant_id": {"$ref": "common.json#/$defs/TenantId"},
    "trace_id": {"$ref": "common.json#/$defs/TraceId"},
    "audit_id": {"type": "string", "minLength": 1},
    "at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": ["admin", "ops", "auditor", "read_only", "system"]},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string"},
    "reason": {"type": "string", "minLength": 1}
  }
}
